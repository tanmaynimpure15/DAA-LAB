#include <stdio.h>
        }
    }

    // Sort by weight; for equal weight keep row-wise order
    qsort(edges, edgeCount, sizeof(Edge), cmp);

    int *parent = (int *)malloc(V * sizeof(int));
    int *rank = (int *)calloc(V, sizeof(int));
    for (int i = 0; i < V; i++)
        parent[i] = i;

    int totalCost = 0;
    int k = 0;

    for (int i = 0; i < edgeCount && k < V - 1; i++) {
        int u = edges[i].u;
        int v = edges[i].v;
        int setU = find(parent, u);
        int setV = find(parent, v);

        if (setU != setV) {
            printf("Edge %d:(%d, %d) cost:%d\n", k, u, v, edges[i].w);
            totalCost += edges[i].w;
            unionSets(parent, rank, setU, setV);
            k++;
        }
    }

    printf("Minimum cost= %d\n", totalCost);

    free(edges);
    free(parent);
    free(rank);
}

int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
